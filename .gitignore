# linux-client/prebuilt/ is a deliberate exception to the build-output
# ignore patterns below - it's the git-tracked fallback Linux client
# binary Install-Server.ps1 uses on machines without the Go toolchain
# installed, so a fresh checkout always has a real client to deploy.
output/
build/
dist/
tmp/
*.log
*.tmp
inventory-index.json

# Internal AI-assisted development scratch - useful locally while building a
# feature, not meant for a reader of the public repo. docs/project-specification.md
# (the one consolidated project spec) is the exception and stays tracked.
docs/superpowers/
.superpowers/
.claude/skills/
